# Copy this file to .env.local (npm run dev) or .env (docker compose) to change it.
#
# The address of the FitTrack API gateway, as seen from the BROWSER. It is public
# by design: anything starting with NEXT_PUBLIC_ is written into the JavaScript
# when the app is built, so never put a secret here.
# (Changing it needs a rebuild: `docker compose up --build`, or restart `npm run dev`.)
NEXT_PUBLIC_API_URL=http://localhost:8080
